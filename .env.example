# ==============================================================================
# Environment Configuration Template (Phase 2 - Big Data Final Project)
# Copy this file to '.env' and adjust values as needed for your local environment.
# Note: DO NOT put real secrets, credentials, or production passwords in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Settings
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=midterm_data_pipeline

# Collections Names
RAW_COLLECTION=orders_raw
VALIDATED_COLLECTION=orders_validated
QUARANTINE_COLLECTION=orders_quarantine
MV_DAILY_SALES=daily_sales_summary
MV_TOP_PRODUCTS=top_products_summary
JOB_LOGS_COLLECTION=job_logs

# ------------------------------------------------------------------------------
# FastAPI Server Settings
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ------------------------------------------------------------------------------
# Pipeline & Batch Ingestion Thresholds
# ------------------------------------------------------------------------------
# Files <= this threshold (in MB) use Python Batch Streaming.
# Files > this threshold use PySpark Distributed Engine.
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=1000

# ------------------------------------------------------------------------------
# Apache Spark Configuration
# ------------------------------------------------------------------------------
SPARK_APP_NAME=OrdersPipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_OFFHEAP_ENABLED=true
SPARK_OFFHEAP_SIZE=2g
